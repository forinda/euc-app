PORT=3000
NODE_ENV=development
# CLIENT_DIR=../web/dist   # built web app; use an absolute path in production
# Session store: Upstash Redis when both are set, otherwise in-memory.
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Live updates via Ably when set (server-side key); otherwise clients poll.
# ABLY_API_KEY=
